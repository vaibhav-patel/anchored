# Copy to .env. The Week 1 baseline runs fully local — no keys required.

# --- Vector store ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=anchored_cuad

# --- Embeddings ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Generation (optional for baseline; retrieval eval needs no LLM) ---
# Local via Ollama:
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1:8b
# Or an OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Retrieval ---
TOP_K=10
CHUNK_SIZE=512
CHUNK_OVERLAP=64
